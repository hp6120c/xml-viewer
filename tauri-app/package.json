{
  "name": "xml-database-viewer",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "npm run build && cargo test --manifest-path src-tauri/Cargo.toml",
    "build:desktop": "tauri build --bundles nsis",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:layout": "node tests/layout-check.mjs",
    "test:markdown-ui": "node tests/markdown-ui-check.mjs",
    "test:markdown-e2e": "node tests/markdown-e2e.mjs",
    "test:markdown-conflict": "node tests/markdown-conflict-check.mjs",
    "test:markdown-assets": "node tests/markdown-assets-check.mjs",
    "test:mixed-tabs": "node tests/mixed-tabs-check.mjs",
    "test:update": "node tests/update-check.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.468.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-anchor": "^4.0.4",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
